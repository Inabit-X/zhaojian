# ===== 应用 =====
APP_NAME=own_partner
APP_ENV=development
DEBUG=false
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=please-change-me-to-a-random-64-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# 宿主机端口；默认避开常见占用，可改回 8000/5432/6379
BACKEND_PORT=18080

# ===== PostgreSQL =====
POSTGRES_USER=own_partner
POSTGRES_PASSWORD=own_partner_dev
POSTGRES_DB=own_partner
POSTGRES_PORT=15432
# 本地开发（宿主机运行 backend）使用 localhost；
# docker compose 会用服务名 db 覆盖 backend 容器的 DATABASE_URL。
DATABASE_URL=postgresql+asyncpg://own_partner:own_partner_dev@localhost:15432/own_partner

# ===== Embedding provider =====
# fake：离线确定性向量，仅用于开发与测试，不具语义相似性
# openai：任何兼容 OpenAI /embeddings 协议的服务
EMBEDDING_PROVIDER=fake
EMBEDDING_DIM=1536
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_SECONDS=30

# ===== LLM provider（预留，本期不调用）=====
LLM_PROVIDER=openai_compat
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=

# ===== 事件切片 =====
CHUNK_SIZE=400
CHUNK_OVERLAP=50
MAX_CHUNKS_PER_EVENT=100

# ===== 可选异步任务（默认不启动）=====
REDIS_PORT=16379
REDIS_URL=redis://localhost:16379/0

# ===== 测试 =====
TEST_DATABASE_URL=postgresql+asyncpg://own_partner:own_partner_dev@localhost:15432/own_partner_test
